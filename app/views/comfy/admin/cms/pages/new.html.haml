.page-header
  %h2= t('.title')

- draft_data = cms_draft_form_data('site', @site.id, 'page', 'new', 'parent', @page.parent_id || 'root', record: @page)
= comfy_form_with model: @page, scope: :page, url: {action: :create}, html: {multipart: true, data: draft_data} do |form|
  = hidden_field_tag :cms_draft_key, draft_data[:cms_draft_key]
  = render form
