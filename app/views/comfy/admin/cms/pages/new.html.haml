.page-header
  %h2= t('.title')

= comfy_form_with model: @page, scope: :page, url: {action: :create}, html: {multipart: true, data: {cms_unsaved_message: t("comfy.admin.cms.forms.unsaved_changes", default: "You have unsaved changes. Are you sure you want to leave this page?")}} do |form|
  = render form
