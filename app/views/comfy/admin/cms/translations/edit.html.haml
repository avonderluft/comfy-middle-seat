- content_for :right_column do
  - link = comfy_admin_cms_site_page_translation_revisions_path(@site, @page, @translation)
  = render "comfy/admin/cms/revisions/sidebar", record: @translation, link: link
  = render "comfy/admin/cms/translations/sidebar"

.page-header
  %h2= t('.title')

- draft_data = cms_draft_form_data('site', @site.id, 'page', @page.id, 'translation', @translation.id, record: @translation)
= comfy_form_with model: @translation, scope: :translation, url: {action: :update}, html: {multipart: true, data: draft_data} do |form|
  = hidden_field_tag :cms_draft_key, draft_data[:cms_draft_key]
  = render form
