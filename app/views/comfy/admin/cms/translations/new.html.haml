.page-header
  %h2= t(".title")

- draft_data = cms_draft_form_data('site', @site.id, 'page', @page.id, 'translation', 'new', record: @translation)
= comfy_form_with model: @translation, scope: :translation, url: {action: :create}, html: {multipart: true, data: draft_data} do |form|
  = hidden_field_tag :cms_draft_key, draft_data[:cms_draft_key]
  = render form
